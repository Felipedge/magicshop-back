# Variables de entorno del backend (IntelliJ: Run > Edit Configurations > Environment variables).
# Todas son opcionales en desarrollo: los valores por defecto están en application.yml.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=magicshop
DB_USER=magicshop
DB_PASSWORD=magicshop123

# Mínimo 32 caracteres. Generar con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

ADMIN_EMAIL=admin@magicshop.com
ADMIN_PASSWORD=admin123
DEMO_USER_EMAIL=comprador@magicshop.com
DEMO_USER_PASSWORD=comprador123
